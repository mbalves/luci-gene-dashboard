# ── Database ──────────────────────────────────────────────────────────────────
# Render provides this automatically when you link a PostgreSQL service.
# For local dev, use your local postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/luci_gene_db

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── NCBI API (optional but strongly recommended for higher rate limits) ───────
# Get a free API key at: https://www.ncbi.nlm.nih.gov/account/
# Without key: 3 req/sec — With key: 10 req/sec
NCBI_API_KEY=
NCBI_EMAIL=your@email.com
